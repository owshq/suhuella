{
  "name": "suhuella",
  "version": "0.1.0-pre-rc",
  "private": true,
  "scripts": {
    "predev": "node ../brands/project-brand.mjs",
    "prebuild": "node ../brands/run-release-gate.mjs && node ../brands/project-brand.mjs && node ../brands/project-site.mjs",
    "build": "npm run prebuild && next build --webpack",
    "dev": "node scripts/dev-safe.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:force": "node scripts/dev-safe.mjs --force",
    "start": "next start",
    "lint": "eslint",
    "check:business-license": "node --experimental-strip-types --disable-warning=ExperimentalWarning lib/business-license-check.ts",
    "test:license": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/license-audit-check.ts",
    "test:download-page": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/download-page-semantics-check.ts",
    "test:desktop-artifacts": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/desktop-release-artifacts-check.ts",
    "test:app-modal-shell": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/route-overlay-check.ts",
    "test:brand-theme": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning ../brands/brand-theme-tokens-check.ts",
    "test:browser-connect": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/browser-connect-source-check.ts",
    "test:browser-connect-playwright": "node scripts/browser-connect-source-playwright.mjs",
    "test:browser-sources-brand-flow": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/browser-sources-brand-flow-check.ts",
    "test:sources-capability-matrix": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/sources-capability-matrix-check.ts",
    "test:browser-sources-card-playwright": "node scripts/browser-sources-card-playwright.mjs",
    "test:browser-organise-selection": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/browser-organise-selection-check.ts",
    "test:browser-organise-selection-playwright": "node scripts/browser-organise-selection-playwright.mjs",
    "test:browser-sources-search-playwright": "node scripts/browser-sources-search-playwright.mjs",
    "test:pre-beta-benchmark": "node scripts/pre-beta-benchmark.mjs",
    "test:pre-beta-readiness": "npm run test:sources-capability-matrix && npm run test:pre-beta-benchmark && npm run verify:production",
    "test:browser-dev-sources": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/browser-dev-sources-check.ts",
    "test:browser-dev-sources-playwright": "node scripts/browser-dev-sources-playwright.mjs",
    "test:checkout": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/checkout-enablement-check.ts",
    "test:grant-durability": "node --experimental-strip-types --import ../brands/node-register.mjs --disable-warning=ExperimentalWarning lib/license-grant-durability-check.ts",
    "test:email": "node --import ../brands/node-register.mjs --experimental-strip-types --disable-warning=ExperimentalWarning lib/resend-email-audit-check.ts",
    "test:otp-production": "node --import ../brands/node-register.mjs --experimental-strip-types --disable-warning=ExperimentalWarning lib/license-otp-production-check.ts",
    "test:resend-dns": "node --import ../brands/node-register.mjs --experimental-strip-types --disable-warning=ExperimentalWarning lib/resend-dns-check.ts",
    "test:resend-otp-proof": "node scripts/resend-otp-live-proof.mjs",
    "test:admin": "node --experimental-strip-types --disable-warning=ExperimentalWarning lib/operations-audit-check.ts",
    "test:operations-auth": "node --experimental-strip-types --disable-warning=ExperimentalWarning lib/operations-auth-check.ts",
    "test:service-health": "node --experimental-strip-types --disable-warning=ExperimentalWarning lib/service-health-audit-check.ts",
    "check:app-host": "tsc --noEmit -p tsconfig.app-host.json",
    "build:worker": "npm run prebuild && next build && node scripts/link-standalone-next.mjs && node scripts/strip-sharp-from-standalone.mjs && opennextjs-cloudflare build --skipNextBuild",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "r2:create": "wrangler r2 bucket create suhuella-downloads",
    "r2:upload:manifest": "wrangler r2 object put suhuella-downloads/release.json --file release.json --content-type application/json",
    "r2:upload:win": "wrangler r2 object put suhuella-downloads/SuHuella-Setup-0.1.0-pre-rc.exe --file ../desktop/.build/suhuella/release/SuHuella-Setup-0.1.0-pre-rc.exe",
    "r2:upload:mac": "wrangler r2 object put suhuella-downloads/SuHuella-0.1.0-pre-rc.dmg --file ../desktop/.build/suhuella/release/SuHuella-0.1.0-pre-rc.dmg",
    "verify:production": "node scripts/verify-production-routes.mjs",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy && npm run verify:production",
    "upload": "npm run build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@suhuella/brand": "file:../brands",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.134.0"
  }
}