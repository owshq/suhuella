# Public app version shown on the landing (keep in sync with desktop/package.json)
NEXT_PUBLIC_APP_VERSION=0.1.0

# Stripe Payment Link used by the download buttons (checkout shows the price)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_...

# Stripe secret key — server only, never expose to the client
STRIPE_SECRET_KEY=sk_test_...

# Installer URLs — server only; returned after payment verification
INSTALLER_WINDOWS_URL=https://downloads.example.com/suhuella-setup.exe
INSTALLER_MAC_URL=https://downloads.example.com/suhuella.dmg
