# Local Next.js only — never commit (.gitignore)
# Public sales stay off until this is exactly "true" AND live Stripe config exists.
PAID_CHECKOUT_ENABLED=false
STRIPE_LIFETIME_PAYMENT_LINK=
STRIPE_MONTHLY_PAYMENT_LINK=
STRIPE_LIFETIME_PRICE_ID=price_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_BUSINESS_PAYMENT_LINK=
BUSINESS_CONTACT_URL=
STRIPE_SECRET_KEY=sk_test_...
RELEASE_MANIFEST_URL=
INSTALLER_WINDOWS_URL=
INSTALLER_MAC_URL=

# Operations console (/_ops) — never hardcode superadmins in application code
# Local: http://localhost:3000/_ops opens with no login (localhost / 127.0.0.1 only).
SUPERADMIN_EMAILS=admin@suhuella.com
# Optional: non-localhost dev hosts (LAN IP, custom hostname)
OPERATIONS_ALLOW_DEV_ACCESS=
OPERATIONS_DEV_EMAIL=

# Production only (Cloudflare Access on /_ops or ops.suhuella.com). Leave empty locally.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional: shown in the Operations identity panel
OPERATIONS_WORKER_ID=
LICENSE_SIGNING_SECRET=
LICENSE_GRANTS=
LICENSE_STORE_PATH=
RESEND_API_KEY=
RESEND_FROM=SuHuella <licenses@suhuella.com>
SUPERADMIN_TOKEN=
SUPERADMIN_EMAIL=admin@suhuella.com
BUSINESS_MIN_SEATS=20
BUSINESS_SEAT_PRICE_CENTS=200
BUSINESS_CURRENCY=eur
BUSINESS_MIN_MONTHLY_CENTS=4000
BUSINESS_STORE_PATH=
