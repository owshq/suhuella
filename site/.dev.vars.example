# Local Wrangler secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to .dev.vars and fill in values. Never commit .dev.vars.

NEXTJS_ENV=development
PAID_CHECKOUT_ENABLED=true
PARTNER_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PARTNER_PRICE_ID=
STRIPE_LIFETIME_UPGRADE_PRICE_ID=
# Payment Links are not the checkout path.
STRIPE_LIFETIME_PAYMENT_LINK=
STRIPE_MONTHLY_PAYMENT_LINK=
BUSINESS_CONTACT_URL=
RELEASE_MANIFEST_URL=
INSTALLER_WINDOWS_URL=
INSTALLER_MAC_URL=

# Operations console (/_ops) — localhost opens with no login in next dev
SUPERADMIN_EMAILS=admin@suhuella.com
OPERATIONS_ALLOW_DEV_ACCESS=
OPERATIONS_DEV_EMAIL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Legacy HMAC license tokens only (server verify until Ed25519 cutover completes).
LICENSE_SIGNING_SECRET=
# Ed25519 — server signs new license tokens (preferred over LICENSE_SIGNING_SECRET).
LICENSE_SIGNING_PRIVATE_KEY=
# Comma-separated SPKI public keys — server-side verify + must match desktop build env below.
LICENSE_SIGNING_PUBLIC_KEYS=
# Email OTP hash (activation codes) — separate from license signing.
LICENSE_EMAIL_OTP_SECRET=
# Partner portal / applicant session cookies — separate from license signing.
PARTNER_SESSION_SECRET=
LICENSE_GRANTS=
RESEND_API_KEY=
RESEND_FROM=SuHuella <licenses@suhuella.com>
SUPERADMIN_TOKEN=
SUPERADMIN_EMAIL=admin@suhuella.com
BUSINESS_MIN_SEATS=20
BUSINESS_SEAT_PRICE_CENTS=200
BUSINESS_CURRENCY=eur
BUSINESS_MIN_MONTHLY_CENTS=4000
BUSINESS_STORE_PATH=

# Partner custom domains (Cloudflare for SaaS) — partners configure DNS in /partners/portal.
# CLOUDFLARE_SAAS_CNAME_TARGET alone enables pending hostname + CNAME instructions locally.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_CNAME_TARGET=

# Cloud integrations — local only. Keep production CLOUD_INTEGRATIONS_ENABLED=false.
CLOUD_INTEGRATIONS_ENABLED=false
# Base64-encoded 32-byte AES key (openssl rand -base64 32). Never commit real values.
CLOUD_TOKEN_ENCRYPTION_KEY=
# Google OAuth Web client (Workspace not required). Never commit real values.
CLOUD_GOOGLE_DRIVE_CLIENT_ID=
CLOUD_GOOGLE_DRIVE_CLIENT_SECRET=
# Microsoft OneDrive (Azure AD app registration). Never commit real values.
CLOUD_ONEDRIVE_CLIENT_ID=
CLOUD_ONEDRIVE_CLIENT_SECRET=
