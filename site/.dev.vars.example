# Local Wrangler secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to .dev.vars and fill in values. Never commit .dev.vars.

NEXTJS_ENV=development
PAID_CHECKOUT_ENABLED=false
STRIPE_LIFETIME_PAYMENT_LINK=
STRIPE_MONTHLY_PAYMENT_LINK=
STRIPE_LIFETIME_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_PAYMENT_LINK=
BUSINESS_CONTACT_URL=
STRIPE_SECRET_KEY=
RELEASE_MANIFEST_URL=
INSTALLER_WINDOWS_URL=
INSTALLER_MAC_URL=

# Operations console (/_ops) — localhost opens with no login in next dev
SUPERADMIN_EMAILS=admin@suhuella.com
OPERATIONS_ALLOW_DEV_ACCESS=
OPERATIONS_DEV_EMAIL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
LICENSE_SIGNING_SECRET=
LICENSE_GRANTS=
RESEND_API_KEY=
RESEND_FROM=SuHuella <licenses@suhuella.com>
SUPERADMIN_TOKEN=
SUPERADMIN_EMAIL=admin@suhuella.com
BUSINESS_MIN_SEATS=20
BUSINESS_SEAT_PRICE_CENTS=200
BUSINESS_CURRENCY=eur
BUSINESS_MIN_MONTHLY_CENTS=4000
BUSINESS_STORE_PATH=
